CHATBOT_API_KEY=

LOG_LEVEL=INFO
LOKI_URL=http://loki:3100
LOKI_ENABLED=false

OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
FAQ_RETRIEVAL_LIMIT=5

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=default
REDIS_PASSWORD=

POSTGRES_USER=chatbot
POSTGRES_PASSWORD=123
DATABASE_URL=postgresql+psycopg://chatbot:123@postgres:5432/chatbot


WHATSAPP_VERIFY_TOKEN=
# Also used for matching_paciente templates (fixed name, language pt_BR).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1107377322449228
# App Secret do app da Meta: confere a assinatura X-Hub-Signature-256 dos webhooks. Obrigatório para abrir o imediato.
WHATSAPP_APP_SECRET=
# Só para testes locais com uma Graph API falsa (exige IMMEDIATE_ALLOW_FAKE=true); em produção fica o padrão.
# WHATSAPP_GRAPH_URL=http://localhost:8099

# Google Sheets API credentials: JSON file path or inline JSON content.
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=
GOOGLE_PATIENTS_SPREADSHEET_URL=
GOOGLE_PROFESSIONALS_SPREADSHEET_URL=

# AWS S3 Configuration
# Bucket utilizado para armazenamento de arquivos enviados pelos usuários.
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
MATCHING_LAMBDA_NAME=

# Lambda/deploy: PostgreSQL URL including user and password.
MATCHING_DATABASE_URL=

# Gmail SMTP address and application password.
GMAIL_ID_CLIENT=
GMAIL_SECRET_CLIENT=

# Acolhimento imediato
# Pix: "fake" em desenvolvimento (pagamento simulado via POST /pix/webhook/{token}); "bb" em produção.
# Liga a entrada "Atendimento imediato" no chatbot. Só abre com a configuração completa (Pix BB, Daily, WHATSAPP_APP_SECRET);
# se faltar algo, continua fechado e o log mostra o que falta.
IMMEDIATE_CARE_ENABLED=false
# Só em testes locais: permite ligar o atendimento com Pix e sala simulados. Em produção, deixe false.
IMMEDIATE_ALLOW_FAKE=false
PIX_PROVIDER=fake
BB_PIX_CLIENT_ID=
BB_PIX_CLIENT_SECRET=
BB_PIX_DEV_APP_KEY=
# Certificado e chave privada do BB montados em secrets/ (nunca no git).
BB_PIX_CERT_PATH=secrets/bb-pix.crt
BB_PIX_KEY_PATH=secrets/bb-pix.key
BB_PIX_CHAVE=
# Homologação (padrão). Produção: https://api-pix.bb.com.br/pix/v2 e https://oauth.bb.com.br/oauth/token
BB_PIX_BASE_URL=https://api-pix.hm.bb.com.br/pix/v2
BB_PIX_OAUTH_URL=https://oauth.hm.bb.com.br/oauth/token
# Segredo que fica na URL do webhook: POST /pix/webhook/{PIX_WEBHOOK_TOKEN}
PIX_WEBHOOK_TOKEN=
# URL pública da API, usada para registrar o webhook no BB.
PUBLIC_BASE_URL=https://chatbot.orgmetamorfose.com.br
# minutos:centavos, na ordem em que o paciente vê
IMMEDIATE_PRICES=10:3000,20:5000,40:10000,60:15000
IMMEDIATE_OFFER_TIMEOUT_SECONDS=300
IMMEDIATE_PAYMENT_TIMEOUT_SECONDS=1800
IMMEDIATE_ROOM_GRACE_MINUTES=15
# Daily (sala de vídeo privada, um token por pessoa). Vazio = sala simulada (só com IMMEDIATE_ALLOW_FAKE=true).
DAILY_API_KEY=
